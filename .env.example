# Set PROJECT_ID sama di laptop dan kedua HP
PROJECT_ID=washalert_kelompokXX

# Broker MQTT cloud publik untuk contoh belajar
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt

# Untuk broker privat saja (jangan commit file .env)
MQTT_USERNAME=
MQTT_PASSWORD=

# Dashboard hanya bisa dibuka dari laptop sendiri
DASHBOARD_PORT=8000

# WashAlert: demo (waktu singkat untuk video) atau real (mesin cuci sungguhan)
CUCI_MODE=demo

# Deteksi. RULE_ONLY tanpa model. HYBRID: model + fallback aturan, FSM tetap memutuskan.
# ML_ONLY (eksperimen): model tanpa fallback per jendela; prediksi tak tersedia menahan timer FSM.
DETECTION_MODE=RULE_ONLY
MODEL_PATH=
# Hanya untuk uji perangkat lunak dengan model SYNTHETIC_*.
ALLOW_SYNTHETIC_MODEL=false

# Opsional. Nilai bawaan ada di nodes/detector_service/rules.py.
# CUCI_MIN_RUN_S=600
# CUCI_DONE_NOSPIN_S=240
# CUCI_ACK_WINDOWS=2
# CUCI_SPIN_WINDOWS=3
# CUCI_SENSOR_LOST_S=60
# CR-006 belum diputuskan. Kosong berarti siklus terlalu singkat tetap menunggu aktivitas berikutnya.
# CUCI_ABANDON_S=

# Menyimpan siklus aktif/DONE agar pulih setelah detector restart. Kosong menonaktifkan.
DETECTOR_STATE_PATH=data/runtime/detector_state.json

# Dashboard. Batas usang dan offline (detik) diusulkan, sesuaikan dengan periode telemetri HP yang terukur.
# DASHBOARD_STALE_S=20
# DASHBOARD_OFFLINE_S=60
# 0.0.0.0 membuka dashboard ke jaringan lokal tanpa login. Pakai hanya di jaringan tepercaya.
# DASHBOARD_HOST=127.0.0.1
